{
	"name": "image-generation-benchmarks",
	"version": "0.1.0",
	"private": true,
	"description": "Fair, reproducible benchmarks for JavaScript image generation libraries across runtimes, scenarios, and output formats.",
	"type": "module",
	"scripts": {
		"assets:generate": "node scripts/generate-assets.ts",
		"baselines:update": "node scripts/update-baselines.ts",
		"bench": "node src/runner/bench.ts",
		"bench:quick": "node src/runner/bench.ts --quick",
		"compare": "node src/runner/compare.ts",
		"fmt": "oxlint --fix && oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint && oxfmt --check",
		"report": "node src/runner/report.ts",
		"typecheck": "tsc --noEmit",
		"validate": "node src/runner/validate.ts"
	},
	"dependencies": {
		"@napi-rs/canvas": "1.0.10",
		"@resvg/resvg-js": "2.6.2",
		"@resvg/resvg-wasm": "2.6.2",
		"@takumi-rs/core": "2.14.0",
		"@takumi-rs/helpers": "2.14.0",
		"canvas": "3.2.3",
		"canvaskit-wasm": "0.42.0",
		"fast-png": "8.0.0",
		"mitata": "1.0.34",
		"pixelmatch": "7.2.0",
		"pureimage": "0.4.20",
		"satori": "0.35.0",
		"skia-canvas": "3.0.8"
	},
	"devDependencies": {
		"@types/node": "25.9.9",
		"@types/react": "19.3.0",
		"oxfmt": "0.71.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2003",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"packageManager": "pnpm@12.9.1",
	"trustedDependencies": [
		"canvas",
		"skia-canvas"
	]
}
